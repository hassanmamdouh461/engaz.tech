---
import { content } from "@/lib/content";
import type { Locale } from "@/lib/types";

interface Props {
  locale: Locale;
  /** Show each stage's deliverable chips (the homepage does; the POS page keeps it short). */
  withNodes?: boolean;
}

const { locale, withNodes = false } = Astro.props;
const { stages } = content.ecosystem;
---

<ol class="grid gap-px border-2 border-ink bg-ink sm:grid-cols-2 lg:grid-cols-4">
  {stages.map((stage, index) => (
    <li class="reveal flex flex-col gap-3 bg-paper p-6">
      <span dir="ltr" class="font-mono text-sm font-semibold rtl:text-end">
        {String(index + 1).padStart(2, "0")}
      </span>
      <h3 class="h3">{stage.title[locale]}</h3>
      <p class="text-sm text-ink/70">{stage.body[locale]}</p>
      {withNodes && (
        <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
          {stage.nodes.map((node) => (
            <li class="border border-ink/25 px-2 py-0.5 font-mono text-xs">
              {node[locale]}
            </li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ol>
