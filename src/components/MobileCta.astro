---
import MessageCircle from "@lucide/astro/icons/message-circle";
import { content } from "@/lib/content";
import { pathFor, whatsappHref } from "@/lib/routes";
import type { Locale, Localized } from "@/lib/types";

interface Props {
  locale: Locale;
  whatsappMessage: Localized;
}

const { locale, whatsappMessage } = Astro.props;
const { ui } = content;
---

{/* On phones the primary action stays one thumb away; body padding keeps it off the footer. */}
<div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-ink/15 bg-paper/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md lg:hidden dark:border-ink/20">
  <a
    href={whatsappHref(whatsappMessage, locale)}
    target="_blank"
    rel="noopener"
    class="btn-primary flex-1"
  >
    <MessageCircle class="size-5" aria-hidden="true" />
    {ui.whatsappCta[locale]}
  </a>
  <a href={pathFor(locale, "contact")} class="btn-secondary px-4">
    {ui.nav.contact[locale]}
  </a>
</div>
