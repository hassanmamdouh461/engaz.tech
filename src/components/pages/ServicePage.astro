---
import MessageCircle from "@lucide/astro/icons/message-circle";
import ClosingCta from "@/components/ClosingCta.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Base from "@/layouts/Base.astro";
import { content } from "@/lib/content";
import { resolveIcon } from "@/lib/icons";
import { type Page, pathFor, whatsappHref } from "@/lib/routes";
import type { Locale, ServicePageKey } from "@/lib/types";

interface Props {
  locale: Locale;
  page: Page;
  serviceKey: ServicePageKey;
}

const { locale, page, serviceKey } = Astro.props;
const { servicePages, services, work, ui, brand, ecosystem } = content;
const data = servicePages[serviceKey];
const t = (value: Record<Locale, string>) => value[locale];

const service = services.items.find((item) => item.id === data.serviceId);
const featured = work.featured.find((item) => item.id === data.featuredId);
const related = data.secondaryIds
  .map((id) => work.secondary.find((item) => item.id === id))
  .filter((item) => item !== undefined);
const ServiceIcon = resolveIcon(service?.icon ?? "");
---

<Base
  locale={locale}
  page={page}
  title={`${t(data.metaTitle)} | ${t(brand.name)}`}
  description={t(data.metaDescription)}
  whatsappMessage={data.whatsappMessage}
>
  <section>
    <div class="frame flex flex-col gap-7 px-4 pt-14 pb-16 sm:px-6 lg:pt-20 lg:pb-20">
      <nav aria-label={t(ui.breadcrumb)} class="eyebrow">
        <a href={pathFor(locale, "home")} class="hover:text-ink">
          {t(brand.name)}
        </a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-ink">
          {t(data.metaTitle)}
        </span>
      </nav>
      <div class="flex items-center gap-3">
        <span class="flex size-12 items-center justify-center border-2 border-ink bg-accent text-accent-ink">
          <ServiceIcon class="size-6" aria-hidden="true" />
        </span>
      </div>
      <h1 class="h1 max-w-4xl">{t(data.heading)}</h1>
      {service && <p class="lead">{t(service.body)}</p>}
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappHref(data.whatsappMessage, locale)}
          target="_blank"
          rel="noopener"
          class="btn-primary"
        >
          <MessageCircle class="size-5" aria-hidden="true" />
          {t(ui.whatsappCta)}
        </a>
        <a href={pathFor(locale, "contact")} class="btn-secondary">
          {t(ui.briefCta)}
        </a>
      </div>
    </div>

    {featured && (
      <div class="rule">
        <dl class="frame grid grid-cols-3">
          {featured.metrics.map((metric, index) => (
            <div
              class:list={[
                "flex flex-col gap-1 px-4 py-8 sm:px-6",
                index > 0 && "border-s border-ink/15 dark:border-ink/20",
              ]}
            >
              <dt class="order-2 text-sm text-ink/70">{t(metric.label)}</dt>
              <dd class="order-1 font-display text-2xl font-semibold tracking-tight sm:text-4xl">
                {t(metric.value)}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </section>

  {featured && (
    <section class="rule">
      <div class="frame px-4 py-16 sm:px-6 lg:py-24">
        <SectionHeader
          index="01"
          eyebrow={t(featured.sector)}
          heading={t(featured.title)}
          body={t(featured.description)}
        />
      </div>
    </section>
  )}

  {data.features.length > 0 && (
    <section class="rule">
      <div class="frame px-4 py-16 sm:px-6 lg:py-24">
        <SectionHeader
          index={featured ? "02" : "01"}
          eyebrow={t(service?.title ?? ui.featuresHeading)}
          heading={t(ui.featuresHeading)}
        />
        <ul class="mt-12 grid gap-px border-2 border-ink bg-ink sm:grid-cols-2 lg:grid-cols-3">
          {data.features.map((feature, index) => (
            <li class="reveal flex flex-col gap-2 bg-paper p-6">
              <span dir="ltr" class="font-mono text-xs text-ink/60 rtl:text-end">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display font-semibold">{t(feature.title)}</h3>
              <p class="text-sm text-ink/70">{t(feature.body)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="rule">
      <div class="frame px-4 py-16 sm:px-6 lg:py-24">
        <h2 class="h2">{t(ui.relatedHeading)}</h2>
        <ul class="mt-10 grid border-t border-s border-ink/15 sm:grid-cols-2 lg:grid-cols-3 dark:border-ink/20">
          {related.map((project) => {
            const Icon = resolveIcon(project.icon);
            return (
              <li class="reveal flex gap-4 border-e border-b border-ink/15 p-5 dark:border-ink/20">
                <Icon class="mt-1 size-5 shrink-0" aria-hidden="true" />
                <div class="flex flex-col gap-1.5">
                  <h3 class="font-semibold">{t(project.title)}</h3>
                  <p class="text-sm text-ink/70">{t(project.description)}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="rule">
    <div class="frame px-4 py-16 sm:px-6 lg:py-24">
      <SectionHeader
        index={String(
          1 +
            (featured ? 1 : 0) +
            (data.features.length > 0 ? 1 : 0) +
            (related.length > 0 ? 1 : 0),
        ).padStart(2, "0")}
        eyebrow={t(ecosystem.eyebrow)}
        heading={t(ecosystem.heading)}
        body={t(ecosystem.body)}
      />
      <div class="mt-12">
        <ProcessSteps locale={locale} />
      </div>
    </div>
  </section>

  <ClosingCta locale={locale} whatsappMessage={data.whatsappMessage} />
</Base>
