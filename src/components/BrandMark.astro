---
/** Brand mark: code chevrons flanking a check — "delivered code" in one glyph. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d="M9 9 L4 16 L9 23"></path>
  <path d="M23 9 L28 16 L23 23"></path>
  <path d="M12.5 16.5 L15.5 19.5 L20 12"></path>
</svg>
