---
import { content } from "@/lib/content";
import type { Locale } from "@/lib/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { brand, ui, intro } = content;
const t = (value: Record<Locale, string>) => value[locale];

// The "order" on the receipt is what Engaz builds.
const items = [ui.nav.pos, ui.nav.aiAgents, ui.nav.websites, ui.nav.mobileApps];

// Torn thermal-paper edge: a sawtooth along the bottom of the receipt.
const teeth = 24;
const edge = Array.from({ length: teeth * 2 + 1 }, (_, k) => {
  const x = teeth * 10 - k * 5;
  return `${x},${k % 2 === 0 ? 0 : 8}`;
}).join(" ");
---

{/*
  First-visit intro, staged in CSS 3D (no WebGL, no library): a camera drifts
  around a solid receipt printer standing on a receding floor, the printer feeds
  out the "order" (what Engaz builds), the logo drops onto it like a stamp, then
  the receipt tears off and flies past the camera while the printer sinks away
  and the yellow sheet flips up like a page to reveal the site. ~2.4s.

  It never blocks the page: the content is already rendered underneath, any
  click, key, scroll or touch skips it, it plays once per session (data-intro
  is set before paint in Base), reduced motion skips it entirely, and without
  JavaScript it still hides itself through its own animation.
*/}
<div class="intro" aria-hidden="true" data-intro-overlay>
  <div class="intro-sheet">
    <div class="intro-floor"></div>
  </div>

  <div class="intro-scene">
    <div class="intro-rig">
      <div class="intro-printer">
        <span class="face face-front">
          <span class="intro-slot"></span>
        </span>
        <span class="face face-top">
          <span class="intro-led"></span>
        </span>
        <span class="face face-left"></span>
        <span class="face face-right"></span>
        <span class="face face-bottom"></span>
      </div>

      <div class="intro-ticket">
        <div class="intro-feed">
          <div class="intro-receipt">
            <div class="intro-paper font-mono">
              <p class="intro-brand">{t(brand.name)}</p>
              <p class="intro-muted">{t(brand.tagline)}</p>
              <p class="intro-rule"></p>
              <p class="intro-row">
                <span>{t(intro.order)}</span>
                <span dir="ltr">#0001</span>
              </p>
              <p class="intro-rule"></p>
              {items.map((item) => (
                <p class="intro-row">
                  <span>
                    <span dir="ltr">1×</span> {t(item)}
                  </span>
                  <span class="intro-dots" />
                  <span>✓</span>
                </p>
              ))}
              <p class="intro-rule"></p>
              <p class="intro-row intro-total">
                <span>{t(intro.status)}</span>
                <span>{t(intro.ready)}</span>
              </p>
              <p class="intro-muted intro-thanks">{t(intro.thanks)}</p>
              <p class="intro-barcode"></p>
            </div>
            <svg class="intro-edge" viewBox="0 0 240 8" preserveAspectRatio="none">
              <polygon points={`0,0 ${edge}`}></polygon>
            </svg>
          </div>
        </div>

        <span class="intro-stamp-shadow"></span>
        <span class="intro-stamp">
          <svg
            viewBox="0 0 32 32"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 9 L4 16 L9 23"></path>
            <path d="M23 9 L28 16 L23 23"></path>
            <path
              class="intro-check"
              d="M12.5 16.5 L15.5 19.5 L20 12"
              pathLength="1"
            ></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  // Any interaction skips the intro: it is a greeting, never a gate.
  const overlay = document.querySelector<HTMLElement>("[data-intro-overlay]");
  if (overlay) {
    const events = ["pointerdown", "keydown", "wheel", "touchstart"];
    const skip = () => {
      overlay.classList.add("is-skipped");
      for (const type of events) window.removeEventListener(type, skip);
    };
    for (const type of events) window.addEventListener(type, skip, { passive: true });
    overlay.addEventListener("animationend", (event) => {
      if (event.animationName.includes("intro-done")) skip();
    });
  }
</script>

<style>
  .intro {
    --ink: #0a0a0a;
    --paper: #ffffff;
    --yellow: #ffd93d;
    /* Printer box: width, height (front face) and depth. */
    --pw: min(27rem, 88vw);
    --ph: 3rem;
    --pd: 7rem;
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow: hidden;
    color: var(--ink);
    animation: intro-done 0s linear 2.45s forwards;
  }

  .intro.is-skipped {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }

  :global([data-intro="seen"]) .intro {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }

  /* ---- The yellow sheet and its floor ------------------------------------ */

  /* Flips up from its top edge like a page being turned, revealing the site. */
  .intro-sheet {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--yellow);
    transform-origin: 50% 0;
    animation: intro-flip 0.5s cubic-bezier(0.45, 0, 0.75, 0.2) 1.85s forwards;
  }

  /* Shading that darkens the page as it turns away from the light. */
  .intro-sheet::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, rgb(10 10 10 / 0.55));
    opacity: 0;
    animation: intro-shade 0.5s ease-in 1.85s forwards;
  }

  /* A dotted plane laid flat and receding into the distance. */
  .intro-floor {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 300vmax;
    height: 300vmax;
    margin-left: -150vmax;
    background: radial-gradient(
        circle at 2px 2px,
        rgb(10 10 10 / 0.28) 2px,
        transparent 0
      )
      0 0 / 44px 44px;
    transform: perspective(700px) rotateX(64deg);
    transform-origin: 50% 0;
    mask-image: linear-gradient(to bottom, #000 0 18%, transparent 60%);
  }

  /* ---- Camera ------------------------------------------------------------ */

  .intro-scene {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    padding-top: clamp(3.5rem, 13vh, 7rem);
    perspective: 1100px;
    perspective-origin: 50% 20%;
  }

  /* The camera drifts from a high three-quarter view towards the front. */
  .intro-rig {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(-38deg) rotateY(34deg) rotateZ(-4deg);
    animation: intro-orbit 1.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* ---- The printer: a solid box built from five faces --------------------- */

  .intro-printer {
    position: relative;
    z-index: 2;
    width: var(--pw);
    height: var(--ph);
    transform-style: preserve-3d;
    transform: scale3d(0.4, 0.4, 0.4);
    animation:
      intro-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      intro-sink 0.45s cubic-bezier(0.55, 0, 1, 0.45) 1.6s forwards;
  }

  .face {
    position: absolute;
    backface-visibility: hidden;
    border: 2px solid var(--ink);
  }

  .face-front {
    inset: 0;
    background: linear-gradient(#262626, #121212);
    transform: translateZ(calc(var(--pd) / 2));
  }

  .face-top {
    left: 0;
    top: calc(50% - var(--pd) / 2);
    width: 100%;
    height: var(--pd);
    background: linear-gradient(#3a3a3a, #1d1d1d);
    transform: rotateX(90deg) translateZ(calc(var(--ph) / 2));
  }

  .face-bottom {
    left: 0;
    top: calc(50% - var(--pd) / 2);
    width: 100%;
    height: var(--pd);
    background: #050505;
    transform: rotateX(-90deg) translateZ(calc(var(--ph) / 2));
  }

  .face-left,
  .face-right {
    top: 0;
    left: calc(50% - var(--pd) / 2);
    width: var(--pd);
    height: 100%;
    background: #0b0b0b;
  }

  .face-left {
    transform: rotateY(-90deg) translateZ(calc(var(--pw) / 2));
  }

  .face-right {
    transform: rotateY(90deg) translateZ(calc(var(--pw) / 2));
  }

  /* The slot the paper feeds out of, along the bottom of the front face. */
  .intro-slot {
    position: absolute;
    inset-inline: 1.1rem;
    bottom: 0.35rem;
    height: 0.3rem;
    border-radius: 999px;
    background: #000;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  }

  .intro-led {
    position: absolute;
    inset-inline-end: 1.2rem;
    top: 1rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 10px #3ddc84;
    animation: intro-blink 0.18s steps(2) 0.35s 5;
  }

  /* ---- The ticket: receipt plus stamp, torn off together ------------------ */

  .intro-ticket {
    position: absolute;
    left: 50%;
    top: calc(var(--ph) - 0.5rem);
    width: min(23.5rem, 80vw);
    margin-left: calc(min(23.5rem, 80vw) / -2);
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--pd) / 2 + 1px));
    animation: intro-tear 0.55s cubic-bezier(0.5, 0, 0.9, 0.35) 1.6s forwards;
  }

  /* Clipped at the slot so the receipt appears to print downward out of it,
     then unclipped the moment it tears so it can fly over the printer. */
  .intro-feed {
    padding: 0 0.6rem 1.5rem;
    clip-path: inset(0 -2rem -4rem -2rem);
    animation: intro-unclip 0s linear 1.6s forwards;
  }

  .intro-receipt {
    filter: drop-shadow(6px 6px 0 var(--ink));
    transform: translateY(-105%);
    animation: intro-print 0.85s steps(16, end) 0.3s forwards;
  }

  .intro-paper {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.6rem 1.25rem 1rem;
    background: linear-gradient(#f3f3f3, var(--paper) 1.2rem);
    font-size: clamp(0.78rem, 0.7rem + 0.3vw, 0.9rem);
    line-height: 1.4;
  }

  .intro-edge {
    display: block;
    width: 100%;
    height: 0.6rem;
    fill: var(--paper);
  }

  .intro-brand {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .intro-muted {
    text-align: center;
    opacity: 0.6;
  }

  .intro-rule {
    margin: 0.35rem 0;
    border-top: 1.5px dashed rgb(10 10 10 / 0.45);
  }

  .intro-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .intro-dots {
    flex: 1;
    border-bottom: 1.5px dotted rgb(10 10 10 / 0.35);
    translate: 0 -0.2rem;
  }

  .intro-total {
    font-weight: 700;
  }

  .intro-total span:last-child {
    background: var(--yellow);
    padding: 0 0.3rem;
  }

  .intro-thanks {
    margin-top: 0.5rem;
  }

  .intro-barcode {
    height: 2.1rem;
    margin: 0.4rem 1.5rem 0;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 4px,
      var(--ink) 4px 5px,
      transparent 5px 8px,
      var(--ink) 8px 11px,
      transparent 11px 12px
    );
  }

  /* ---- The stamp: dropped from above the camera onto the paper ------------ */

  .intro-stamp,
  .intro-stamp-shadow {
    position: absolute;
    inset-inline-end: -0.6rem;
    bottom: 2.6rem;
    width: 4.5rem;
    height: 4.5rem;
  }

  .intro-stamp {
    display: flex;
    padding: 0.85rem;
    border: 3px solid var(--ink);
    background: var(--yellow);
    box-shadow: 4px 4px 0 var(--ink);
    opacity: 0;
    transform: translateZ(560px) rotateZ(-34deg) rotateX(18deg);
    animation: intro-drop 0.34s cubic-bezier(0.5, 0, 0.75, 0) 1.15s forwards;
  }

  .intro-stamp svg {
    width: 100%;
    height: 100%;
  }

  /* Its shadow tightens and darkens as it comes down. */
  .intro-stamp-shadow {
    background: rgb(10 10 10 / 0.5);
    filter: blur(10px);
    opacity: 0;
    transform: translateZ(1px) scale(1.9);
    animation: intro-shadow 0.34s cubic-bezier(0.5, 0, 0.75, 0) 1.15s forwards;
  }

  .intro-check {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: intro-draw 0.22s ease-out 1.42s forwards;
  }

  /* ---- Keyframes ---------------------------------------------------------- */

  @keyframes intro-orbit {
    to {
      transform: rotateX(-14deg) rotateY(9deg) rotateZ(-1deg);
    }
  }

  @keyframes intro-pop {
    to {
      transform: scale3d(1, 1, 1);
    }
  }

  @keyframes intro-blink {
    50% {
      opacity: 0.15;
    }
  }

  @keyframes intro-print {
    to {
      transform: translateY(0);
    }
  }

  @keyframes intro-drop {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: translateZ(4px) rotateZ(-9deg) rotateX(0deg);
    }
  }

  @keyframes intro-shadow {
    to {
      opacity: 1;
      transform: translateZ(1px) scale(1);
    }
  }

  @keyframes intro-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes intro-unclip {
    to {
      clip-path: inset(-300vh -60vw -60vh -60vw);
    }
  }

  /* Torn off: lifted towards the camera, flipped, and flung up out of frame. */
  @keyframes intro-tear {
    0% {
      transform: translateZ(calc(var(--pd) / 2 + 1px));
    }
    35% {
      transform: translate3d(0, -4vh, 160px) rotateX(-18deg) rotateZ(-4deg);
    }
    100% {
      transform: translate3d(8vw, -130vh, 520px) rotateX(-55deg) rotateZ(-16deg);
    }
  }

  /* The printer drops back into the distance and fades. */
  @keyframes intro-sink {
    to {
      transform: translate3d(0, 6rem, -700px) rotateX(20deg);
      opacity: 0;
    }
  }

  @keyframes intro-flip {
    to {
      transform: perspective(1300px) rotateX(-100deg);
    }
  }

  @keyframes intro-shade {
    to {
      opacity: 1;
    }
  }

  @keyframes intro-done {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
