---
/**
 * Renders copy carrying ==marker== spans as highlighted text. Keeping the marker
 * in content.json means the emphasis travels with the translation instead of
 * being pinned to a word position in the markup.
 */
interface Props {
  text: string;
}

const parts = Astro.props.text.split(/==(.+?)==/g);
---

{parts.map((part, index) => (index % 2 === 1 ? <mark class="mark">{part}</mark> : part))}
